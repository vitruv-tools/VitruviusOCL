{
  "name": "vitruvocl",
  "displayName": "VitruvOCL",
  "description": "OCL constraint evaluation for Multi-Model Scenarios within the Vitruvius Framework",
  "version": "0.0.1",
  "publisher": "vitruvocl",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "VitruvOCL runs Java processes that load models and metamodels from the workspace."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vitruvocl",
        "aliases": [
          "vitruvocl",
          "vocl"
        ],
        "extensions": [
          ".ocl",
          ".vocl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vitruvocl",
        "scopeName": "source.vitruvocl",
        "path": "./syntaxes/vitruvocl.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "VitruvOCL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/vitruvocl-dark.json"
      }
    ],
    "views": {
      "test": [
        {
          "id": "vitruvoclTestExplorer",
          "name": "VitruvOCL Constraints"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vitruvocl.runAllConstraints",
          "when": "view == vitruvocl",
          "group": "navigation"
        },
        {
          "command": "vitruvocl.refreshExplorer",
          "when": "view == vitruvoclTestExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vitruvocl.runConstraint",
          "when": "view == vitruvoclTestExplorer && viewItem == constraint",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "vitruvocl.runConstraint",
        "title": "Run VitruvOCL Constraint",
        "icon": "$(play)"
      },
      {
        "command": "vitruvocl.runAllConstraints",
        "title": "Run All VitruvOCL Constraints",
        "icon": "$(play-circle)"
      },
      {
        "command": "vitruvocl.resetProjectChoices",
        "title": "VitruvOCL: Forget the VSUM Choice and Resolve Maven Dependencies Again"
      },
      {
        "command": "vitruvocl.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vitruvocl.checkDocument",
        "title": "Check VitruvOCL Document",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "VitruvOCL",
      "properties": {
        "vitruvocl.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to vitruvocl.jar (leave empty for auto-detection). Only read from user settings, never from workspace settings, because the jar is executed."
        },
        "vitruvocl.languageServerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to language-server.jar (leave empty for auto-detection from lib/). Only read from user settings, never from workspace settings, because the jar is executed."
        },
        "vitruvocl.vsumPath": {
          "type": "string",
          "default": "",
          "description": "Path to your VSUM storage folder (absolute or relative to workspace root). E.g. 'vsumexample' or 'vsum/target/vsumtest'. Leave empty for auto-detection."
        },
        "vitruvocl.mavenDependencies": {
          "type": "string",
          "enum": ["online", "offline", "off"],
          "enumDescriptions": [
            "Resolve the metamodels of the project's Maven dependencies; a run may download what the local repository lacks. Opening a document only uses the local repository.",
            "Resolve them from the local Maven repository only, never download.",
            "Do not use Maven: only the workspace's own .ecore files are metamodels."
          ],
          "default": "online",
          "description": "Whether metamodels that a Maven project only gets from its dependencies (e.g. PCM) are found by running Maven (mvn dependency:build-classpath)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "tsc -p tsconfig.test.json && cd target/test-js && node --test"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^7.0.2"
  }
}