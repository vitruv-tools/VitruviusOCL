<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Build Parent -->
    <parent>
        <groupId>tools.vitruv</groupId>
        <artifactId>parent</artifactId>
        <version>4.0.0</version>
    </parent>

    <!-- Project Information -->
    <artifactId>tools.vitruv.vitruvocl</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>VitruviusOCL</name>
    <description>OCL dialect for constraints across the models of a Vitruvius VSUM</description>
    <url>https://github.com/vitruv-tools/VitruviusOCL</url>

    <!-- Organizational Information -->
    <licenses>
        <license>
            <name>Eclipse Public License - v 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/vitruv-tools/VitruviusOCL.git</connection>
        <developerConnection>scm:git:https://github.com/vitruv-tools/VitruviusOCL.git</developerConnection>
        <url>https://github.com/vitruv-tools/VitruviusOCL/tree/main</url>
    </scm>

    <!-- Modules -->
    <modules>
        <module>vitruvocl-allinstances</module>
        <module>language</module>
        <module>vitruvocl-language-server</module>
        <module>vitruvocl-vscode-extension</module>
    </modules>

    <properties>
        <!-- SonarQube configuration -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>vitruv-tools</sonar.organization>
        <sonar.projectKey>vitruv-tools_VitruviusOCL</sonar.projectKey>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!-- Vitruvius versions -->
        <!-- framework version, must provide the constraint SPI (tools.vitruv.framework.vsum.constraints) -->
        <vitruv.version>4.0.2-SNAPSHOT</vitruv.version>
        <!-- Vitruv-Change version used by the framework version above -->
        <vitruv-change.version>4.0.1</vitruv-change.version>

        <!-- External dependency versions -->
        <antlr4.version>4.13.2</antlr4.version>
        <emf.common.version>2.46.0</emf.common.version>
        <emf.ecore.version>2.43.0</emf.ecore.version>
        <emf.ecore.xmi.version>2.41.0</emf.ecore.xmi.version>
        <equinox.common.version>3.21.0</equinox.common.version>
        <guava.version>33.7.2-jre</guava.version>
        <!-- Must match the junit-platform-launcher/engine versions the parent pins for maven-surefire-plugin -->
        <junit.jupiter.version>6.1.3</junit.jupiter.version>
        <junit.platform.version>6.1.3</junit.platform.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.24.0</mockito.version>
        <lsp4j.version>1.0.0</lsp4j.version>
        <gson.version>2.14.0</gson.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <!-- Dependency Management -->
    <dependencyManagement>
        <dependencies>
            <!-- Vitruvius dependencies -->
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.atomic</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.correspondence</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.composite</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.interaction</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.propagation</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.change.utils</artifactId>
                <version>${vitruv-change.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.framework.views</artifactId>
                <version>${vitruv.version}</version>
            </dependency>
            <dependency>
                <groupId>tools.vitruv</groupId>
                <artifactId>tools.vitruv.framework.vsum</artifactId>
                <version>${vitruv.version}</version>
            </dependency>

            <!-- ANTLR4 runtime (the parent only manages antlr3) -->
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>${antlr4.version}</version>
            </dependency>

            <!-- EMF -->
            <dependency>
                <groupId>org.eclipse.emf</groupId>
                <artifactId>org.eclipse.emf.common</artifactId>
                <version>${emf.common.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.emf</groupId>
                <artifactId>org.eclipse.emf.ecore</artifactId>
                <version>${emf.ecore.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.emf</groupId>
                <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
                <version>${emf.ecore.xmi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.platform</groupId>
                <artifactId>org.eclipse.equinox.common</artifactId>
                <version>${equinox.common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- Language server -->
            <dependency>
                <groupId>org.eclipse.lsp4j</groupId>
                <artifactId>org.eclipse.lsp4j</artifactId>
                <version>${lsp4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>${junit.platform.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.antlr</groupId>
                    <artifactId>antlr4-maven-plugin</artifactId>
                    <version>${antlr4.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <!-- Disable the MWE2 workflow generation the parent configures for the exec plugin -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                    <executions>
                        <execution>
                            <id>execute-mwe2-generate</id>
                            <phase>none</phase>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
